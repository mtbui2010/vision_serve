# Triton config template for the W1/W4 "same ONNX" baseline (ONNX Runtime backend, CUDA EP).
# This is a TEMPLATE: verify input/output names + dims against the actual ONNX graph
# (see eval/baselines/triton/README.md step 2) before serving — placeholders are marked TODO.

name: "mobilenet_v3_onnx"
backend: "onnxruntime"
max_batch_size: 0          # 0 = no Triton batching dim; the ONNX graph carries its own batch.
                           # Set >0 AND enable dynamic_batching to run the W4 batching contrast.

# TODO: replace name "input"/"output" and the dims with the values printed by the
# onnxruntime inspection in README.md. mobilenet-v3 manifest uses 224x224 NCHW.
input [
  {
    name: "input"          # TODO: real input tensor name from the graph
    data_type: TYPE_FP32
    dims: [ 1, 3, 224, 224 ]
  }
]
output [
  {
    name: "output"         # TODO: real output tensor name from the graph
    data_type: TYPE_FP32
    dims: [ 1, 1000 ]      # TODO: real logits dim (ImageNet = 1000)
  }
]

instance_group [
  {
    # Sweep `count` for the W4 instance-group axis (Triton's analogue of SessionPool size).
    count: 1
    kind: KIND_GPU
    gpus: [ 0 ]
  }
]

# Force the CUDA execution provider so this matches VisionServe's CUDA EP (engine control).
optimization {
  execution_accelerators {
    gpu_execution_accelerator: [ { name: "cuda" } ]
  }
}

# --- W4 dynamic-batching contrast (VisionServe is batch=1). Uncomment + set max_batch_size>0:
# dynamic_batching {
#   max_queue_delay_microseconds: 1000   # sweep this for the latency/throughput frontier
# }
