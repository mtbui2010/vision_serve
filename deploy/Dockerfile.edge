# deploy/Dockerfile.edge — image nhẹ cho edge/arm64 (vd Jetson).
# Trên Jetson nên dùng base L4T (nvcr.io/nvidia/l4t-base) + ORT build kèm TensorRT EP.

# --- Stage build (cross-compile arm64) ---
FROM golang:1.22-bookworm AS build
WORKDIR /src
# Binding ORT dùng cgo -> cross-build arm64 cần CGO_ENABLED=1 + cross-compiler aarch64.
RUN apt-get update && apt-get install -y --no-install-recommends gcc-aarch64-linux-gnu && \
    rm -rf /var/lib/apt/lists/*
COPY go.mod go.sum* ./
RUN go mod download || true
COPY . .
RUN CGO_ENABLED=1 GOOS=linux GOARCH=arm64 CC=aarch64-linux-gnu-gcc \
    go build -ldflags '-s -w' -o /out/visionserve ./cmd/visionserve

# --- Stage runtime (arm64) ---
# Lưu ý: với Jetson, thay base bằng nvcr.io/nvidia/l4t-base:r36.x để có CUDA/TensorRT.
FROM arm64v8/ubuntu:22.04
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates && \
    rm -rf /var/lib/apt/lists/*

# TODO: COPY libonnxruntime.so (bản arm64 + TensorRT/CUDA EP cho Jetson) vào /usr/local/lib/
ENV ORT_DYLIB_PATH=/usr/local/lib/libonnxruntime.so
ENV LD_LIBRARY_PATH=/usr/local/lib:${LD_LIBRARY_PATH}

COPY --from=build /out/visionserve /usr/local/bin/visionserve
VOLUME ["/models"]
ENV VISIONSERVE_MODELS=/models
EXPOSE 11435

ENTRYPOINT ["visionserve"]
CMD ["serve", "--addr", ":11435"]
