# deploy/Dockerfile.edge — VisionServe SERVER image for arm64 edge devices (e.g. Jetson).
#
# JetPack 6 (Orin) only. Jetson Thor runs JetPack 7 (CUDA 13, SBSA-aligned, no l4t-* images):
# use deploy/Dockerfile.thor.
#
# Two ways to provide ONNX Runtime, chosen with ORT_SOURCE:
#
#   ORT_SOURCE=cpu  (default) — the official linux-aarch64 CPU build from the ONNX Runtime GitHub
#                   releases, on debian:bookworm-slim. Portable: any arm64 box, Jetson included,
#                   but CPU only (no CUDA/TensorRT).
#
#   ORT_SOURCE=jetson — JetPack 6.1 / 6.2 (L4T r36.4): CUDA 12.6, cuDNN 9.3, TensorRT 10.3.
#                   Runtime base: NVIDIA's nvcr.io/nvidia/l4t-jetpack:r36.4.0, which carries
#                   CUDA, cuDNN and TensorRT inside the image. (Since JetPack 5, l4t-base no
#                   longer mounts them from the host, so an l4t-base image cannot load ORT's CUDA
#                   provider.) ONNX Runtime: the onnxruntime-gpu 1.24.0 wheel of the Jetson AI Lab
#                   jp6/cu126 index (CUDA + TensorRT providers, built for JetPack 6 / CUDA 12.6),
#                   pinned by SHA-256; only its shared libraries are copied.
#
#   Checked 2026-10-05 with `docker manifest inspect` and the NGC registry: the old default
#   nvcr.io/nvidia/l4t-ml:r36.3.0 does not exist (l4t-ml stops at r36.2.0-py3), and l4t-ml
#   r36.2.0-py3 ships ONNX Runtime 1.16.3, older than the 1.20 C API (ORT_API_VERSION 20) that
#   this binary's onnxruntime_go v1.13 binding requests. l4t-jetpack r36.2.0 / r36.3.0 / r36.4.0
#   exist; r36.4.0 matches the cu126 wheel.
#
# Every stage that RUNs a command runs on the BUILD platform, so `docker buildx --platform
# linux/arm64` needs no QEMU; the arm64 stages only copy files.
#
# Examples:
#   # Portable arm64 CPU image:
#   docker buildx build --platform linux/arm64 -f deploy/Dockerfile.edge -t visionserve:edge --load .
#   # Jetson Orin, JetPack 6.1 / 6.2 (CUDA + TensorRT EP); run it with --runtime nvidia:
#   docker buildx build --platform linux/arm64 -f deploy/Dockerfile.edge --build-arg ORT_SOURCE=jetson \
#       -t visionserve:jetson --load .
#
# Model weights are NOT baked into the image — pull them at runtime into /root/.models
# (declared as a VOLUME, so they persist without a -v flag).

ARG ORT_VERSION=1.20.1
ARG ORT_SOURCE=cpu
ARG VERSION=docker-arm
# ORT_SOURCE=jetson only: the runtime base and the ONNX Runtime wheel (see above).
ARG L4T_BASE=nvcr.io/nvidia/l4t-jetpack:r36.4.0
ARG JETSON_ORT_WHEEL_INDEX=https://pypi.jetson-ai-lab.io/jp6/cu126
ARG JETSON_ORT_VERSION=1.24.0
# sha256 of onnxruntime_gpu-1.24.0-cp310-cp310-linux_aarch64.whl from the index above (2026-10-05).
ARG JETSON_ORT_WHEEL_SHA256=d980b934b9a29c1a9d6f39751edd7662b69fadd75556a10ff363773a58ce0950

############################
# Stage 1 — build the Go binary for arm64
############################
# The yalue/onnxruntime_go binding uses cgo, so building for arm64 needs CGO_ENABLED=1
# and an aarch64 C compiler. `--platform=$BUILDPLATFORM` makes this stage run natively on
# the build host (no QEMU emulation, even under `buildx --platform linux/arm64`); Go then
# cross-compiles with the aarch64-linux-gnu-gcc toolchain installed below. The target is
# always linux/arm64 (this Dockerfile only builds arm64 images), so GOARCH is fixed.
# libc6-dev-arm64-cross (the arm64 libc headers) is only a Recommends of the compiler
# package, so --no-install-recommends must name it or cgo fails on <bits/...> headers.
FROM --platform=$BUILDPLATFORM golang:1.22-bookworm AS build
# Global ARGs are only visible inside a stage that re-declares them; without this line
# ${VERSION} below would be empty and the binary would report no version.
ARG VERSION
WORKDIR /src
RUN apt-get update && \
    apt-get install -y --no-install-recommends gcc-aarch64-linux-gnu libc6-dev-arm64-cross && \
    rm -rf /var/lib/apt/lists/*
COPY go.mod go.sum* ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=1 GOOS=linux GOARCH=arm64 CC=aarch64-linux-gnu-gcc \
    go build -ldflags "-s -w -X visionserve/internal/cli.Version=${VERSION}" \
    -o /out/visionserve ./cmd/visionserve

############################
# Stage 2a — fetch ONNX Runtime (portable arm64 CPU build), on the build platform
############################
# Downloading and unpacking a tarball is the same on any CPU, so this stage runs natively. It
# also provides the CA bundle the runtime image needs for `visionserve pull` (HTTPS).
FROM --platform=$BUILDPLATFORM debian:bookworm-slim AS ort-cpu
ARG ORT_VERSION
RUN apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates curl && \
    rm -rf /var/lib/apt/lists/*
# Official arm64 CPU asset: onnxruntime-linux-aarch64-<ver>.tgz
RUN set -eux; \
    url="https://github.com/microsoft/onnxruntime/releases/download/v${ORT_VERSION}/onnxruntime-linux-aarch64-${ORT_VERSION}.tgz"; \
    curl -fSL "$url" -o /tmp/ort.tgz; \
    mkdir -p /opt/ort; \
    tar -xzf /tmp/ort.tgz -C /opt/ort --strip-components=1; \
    rm /tmp/ort.tgz; \
    ls -l /opt/ort/lib/libonnxruntime.so*

############################
# Stage 2b — ONNX Runtime (CUDA 12.6 + TensorRT EP) out of the Jetson AI Lab wheel, on the build platform
############################
# The CUDA/TensorRT execution providers are SEPARATE shared objects that ORT dlopens at session
# creation (libonnxruntime_providers_shared.so, _cuda.so, _tensorrt.so) from the directory
# libonnxruntime.so was loaded from. Copying only libonnxruntime.so* gives an image whose CUDA EP
# silently falls back to the CPU, so every libonnxruntime* of the ONE wheel is copied together.
FROM --platform=$BUILDPLATFORM python:3.12-slim-bookworm AS ort-jetson-src
ARG JETSON_ORT_WHEEL_INDEX
ARG JETSON_ORT_VERSION
ARG JETSON_ORT_WHEEL_SHA256
RUN set -eux; \
    pip download --no-deps --only-binary=:all: --platform linux_aarch64 --python-version 3.10 \
        --index-url "${JETSON_ORT_WHEEL_INDEX}" "onnxruntime-gpu==${JETSON_ORT_VERSION}" -d /tmp/whl; \
    whl="$(ls /tmp/whl/onnxruntime_gpu-*.whl)"; \
    echo "${JETSON_ORT_WHEEL_SHA256}  ${whl}" | sha256sum -c -; \
    mkdir -p /export; \
    python - "$whl" <<'EOF'
import sys, zipfile, os
z = zipfile.ZipFile(sys.argv[1])
libs = [n for n in z.namelist() if n.startswith("onnxruntime/capi/libonnxruntime")]
assert any("providers_cuda" in n for n in libs), "the wheel has no CUDA execution provider"
for n in libs:
    with z.open(n) as src, open(os.path.join("/export", os.path.basename(n)), "wb") as dst:
        dst.write(src.read())
core = [os.path.basename(n) for n in libs if os.path.basename(n).startswith("libonnxruntime.so.")]
assert len(core) == 1, core
os.symlink(core[0], "/export/libonnxruntime.so")
print("ONNX Runtime libraries:", sorted(os.listdir("/export")))
EOF

############################
# Stage 3a — portable arm64 CPU runtime
############################
FROM --platform=linux/arm64 debian:bookworm-slim AS runtime-cpu
COPY --from=ort-cpu /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=ort-cpu /opt/ort/lib/libonnxruntime*.so* /usr/local/lib/

############################
# Stage 3b — Jetson runtime (l4t-jetpack: CUDA, cuDNN, TensorRT inside) + ORT from stage 2b
############################
FROM --platform=linux/arm64 ${L4T_BASE} AS runtime-jetson
# Core + provider libraries, all from the same wheel. They sit next to libonnxruntime.so, where
# ORT looks for providers. CUDA 12.6, cuDNN 9 and TensorRT 10 come from the base image; the
# GPU driver (libcuda, nvgpu) comes from the host through `--runtime nvidia`.
COPY --from=ort-jetson-src /export/ /usr/local/lib/

############################
# Final — select runtime by ORT_SOURCE
############################
FROM runtime-${ORT_SOURCE} AS final

ENV ORT_DYLIB_PATH=/usr/local/lib/libonnxruntime.so
# /usr/local/cuda/lib64 exists only in the Jetson image (it is the base image's own path, which
# this ENV would otherwise replace).
ENV LD_LIBRARY_PATH=/usr/local/lib:/usr/local/cuda/lib64

COPY --from=build /out/visionserve /usr/local/bin/visionserve

# Default model registry at /root/.models (no --models flag / no -v needed).
ENV VISIONSERVE_MODELS=/root/.models
VOLUME ["/root/.models"]
EXPOSE 11435
ENTRYPOINT ["visionserve"]
CMD ["serve", "--addr", ":11435"]
