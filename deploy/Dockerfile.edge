# deploy/Dockerfile.edge — VisionServe SERVER image for arm64 edge devices (e.g. Jetson).
#
# JetPack 6 (Orin) only. Jetson Thor runs JetPack 7 (CUDA 13, SBSA-aligned, no l4t-* images):
# use deploy/Dockerfile.thor. NOTE (checked 2026-10-05): the default L4T_ML_IMAGE tag below,
# l4t-ml:r36.3.0, does not exist on NGC (l4t-ml stops at r36.2.0); pass one that exists.
#
# There is no single, stable, public download URL for an ONNX Runtime *C/C++ shared
# library* built with the TensorRT/CUDA execution providers for Jetson: that build must
# match the device's JetPack (CUDA + cuDNN + TensorRT) versions and is normally produced
# from source or taken from a JetPack-matched package. We therefore expose a build-arg to
# pick how the runtime ONNX Runtime is provided:
#
#   ORT_SOURCE=cpu  (default) — download the official linux-aarch64 CPU build from the
#                   ONNX Runtime GitHub releases. Portable, works on any arm64 box and on
#                   Jetson, but runs on CPU only (no TensorRT/CUDA acceleration).
#
#   ORT_SOURCE=jetson — use a base image that already ships ONNX Runtime with the
#                   TensorRT/CUDA EP (NVIDIA L4T ML containers do), OR expect a Jetson ORT
#                   .so to be present in the build context under deploy/ort-jetson/. This
#                   path is hardware-specific; see the ASSUMPTIONS block below and
#                   deploy/README.md before using it.
#
# Examples:
#   # Portable arm64 CPU image:
#   docker buildx build --platform linux/arm64 -f deploy/Dockerfile.edge -t visionserve:edge .
#   # Jetson (TensorRT/CUDA), built ON the Jetson or with an L4T base:
#   docker build -f deploy/Dockerfile.edge --build-arg ORT_SOURCE=jetson \
#       --build-arg L4T_BASE=nvcr.io/nvidia/l4t-base:r36.3.0 -t visionserve:jetson .
#
# Model weights are NOT baked into the image — pull them at runtime into /root/.models
# (declared as a VOLUME, so they persist without a -v flag).

ARG ORT_VERSION=1.20.1
ARG ORT_SOURCE=cpu
ARG VERSION=docker-arm
# L4T ML image that ships libonnxruntime.so with CUDA+TRT EP for arm64.
# r36.x = JetPack 6.x (CUDA 12.2 + TensorRT 8.6).
# Used ONLY when ORT_SOURCE=jetson.
ARG L4T_BASE=nvcr.io/nvidia/l4t-base:r36.3.0
ARG L4T_ML_IMAGE=nvcr.io/nvidia/l4t-ml:r36.3.0

############################
# Stage 1 — build the Go binary for arm64
############################
# The yalue/onnxruntime_go binding uses cgo, so building for arm64 needs CGO_ENABLED=1
# and an aarch64 C compiler. `--platform=$BUILDPLATFORM` makes this stage run natively on
# the build host (no QEMU emulation, even under `buildx --platform linux/arm64`); Go then
# cross-compiles with the aarch64-linux-gnu-gcc toolchain installed below. The target is
# always linux/arm64 (this Dockerfile only builds arm64 images), so GOARCH is fixed.
# libc6-dev-arm64-cross (the arm64 libc headers) is only a Recommends of the compiler
# package, so --no-install-recommends must name it or cgo fails on <bits/...> headers.
FROM --platform=$BUILDPLATFORM golang:1.22-bookworm AS build
# Global ARGs are only visible inside a stage that re-declares them; without this line
# ${VERSION} below would be empty and the binary would report no version.
ARG VERSION
WORKDIR /src
RUN apt-get update && \
    apt-get install -y --no-install-recommends gcc-aarch64-linux-gnu libc6-dev-arm64-cross && \
    rm -rf /var/lib/apt/lists/*
COPY go.mod go.sum* ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=1 GOOS=linux GOARCH=arm64 CC=aarch64-linux-gnu-gcc \
    go build -ldflags "-s -w -X visionserve/internal/cli.Version=${VERSION}" \
    -o /out/visionserve ./cmd/visionserve

############################
# Stage 2 — fetch ONNX Runtime (portable arm64 CPU build)
############################
FROM --platform=linux/arm64 debian:bookworm-slim AS ort-cpu
ARG ORT_VERSION
RUN apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates curl && \
    rm -rf /var/lib/apt/lists/*
# Official arm64 CPU asset: onnxruntime-linux-aarch64-<ver>.tgz
RUN set -eux; \
    url="https://github.com/microsoft/onnxruntime/releases/download/v${ORT_VERSION}/onnxruntime-linux-aarch64-${ORT_VERSION}.tgz"; \
    curl -fSL "$url" -o /tmp/ort.tgz; \
    mkdir -p /opt/ort; \
    tar -xzf /tmp/ort.tgz -C /opt/ort --strip-components=1; \
    rm /tmp/ort.tgz; \
    ls -l /opt/ort/lib/libonnxruntime.so*

############################
# Stage 3a — portable arm64 CPU runtime
############################
FROM --platform=linux/arm64 debian:bookworm-slim AS runtime-cpu
RUN apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates && \
    rm -rf /var/lib/apt/lists/*
COPY --from=ort-cpu /opt/ort/lib/libonnxruntime*.so* /usr/local/lib/

############################
# Stage 2c — extract ORT from L4T-ML (Jetson CUDA+TRT EP)
############################
# L4T-ML ships ONNX Runtime built with the CUDA+TensorRT EP as part of the Python onnxruntime
# package. The CUDA/TensorRT execution providers are SEPARATE shared objects that ORT dlopens at
# session creation — libonnxruntime_providers_shared.so, libonnxruntime_providers_cuda.so,
# libonnxruntime_providers_tensorrt.so — from the directory libonnxruntime.so itself was loaded
# from (or LD_LIBRARY_PATH). Copying only libonnxruntime.so* (as this stage used to) produced an
# image whose CUDA/TensorRT EPs silently failed to load and fell back to CPU.
#
# So: pick ONE directory — the one holding the CUDA provider, i.e. the GPU build — and copy every
# libonnxruntime*.so* from it, core and providers together, so they are guaranteed to be the same
# ORT build. (A blind `find / -name ...` copy could mix copies from different installs.) The build
# fails if that directory has no core library; it warns if no CUDA provider exists at all.
FROM ${L4T_ML_IMAGE} AS ort-jetson-src
RUN set -eu; \
    mkdir -p /export; \
    cuda="$(find / -xdev -name 'libonnxruntime_providers_cuda.so' -not -path '/proc/*' 2>/dev/null | head -n1)"; \
    if [ -n "$cuda" ]; then dir="$(dirname "$cuda")"; \
    else \
      echo "WARNING: no libonnxruntime_providers_cuda.so in the L4T-ML image: the image will run on CPU only"; \
      core="$(find / -xdev -name 'libonnxruntime.so*' -not -path '/proc/*' 2>/dev/null | head -n1)"; \
      [ -n "$core" ] || { echo "ERROR: no libonnxruntime.so in the L4T-ML image"; exit 1; }; \
      dir="$(dirname "$core")"; \
    fi; \
    echo "ONNX Runtime libraries from: $dir"; \
    ls "$dir"/libonnxruntime.so* >/dev/null 2>&1 || { echo "ERROR: $dir has providers but no libonnxruntime.so*"; exit 1; }; \
    cp -a "$dir"/libonnxruntime*.so* /export/; \
    if [ ! -e /export/libonnxruntime.so ]; then \
      ln -s "$(cd /export && ls libonnxruntime.so.* | head -n1)" /export/libonnxruntime.so; \
    fi; \
    ls -l /export/

############################
# Stage 3b — Jetson runtime (L4T base + ORT extracted above)
############################
FROM ${L4T_BASE} AS runtime-jetson
RUN apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates && \
    rm -rf /var/lib/apt/lists/* || true
# Core + provider libraries, all from the same directory of the same ORT build (see stage 2c).
# They sit next to libonnxruntime.so, where ORT looks for providers, and LD_LIBRARY_PATH below
# also points here. The CUDA/cuDNN/TensorRT libraries the providers link against come from
# JetPack on the host, mounted by `--runtime nvidia`.
COPY --from=ort-jetson-src /export/ /usr/local/lib/

############################
# Final — select runtime by ORT_SOURCE
############################
FROM runtime-${ORT_SOURCE} AS final
RUN ldconfig || true

ENV ORT_DYLIB_PATH=/usr/local/lib/libonnxruntime.so
ENV LD_LIBRARY_PATH=/usr/local/lib

COPY --from=build /out/visionserve /usr/local/bin/visionserve

# Default model registry at /root/.models (no --models flag / no -v needed).
ENV VISIONSERVE_MODELS=/root/.models
VOLUME ["/root/.models"]
EXPOSE 11435
ENTRYPOINT ["visionserve"]
CMD ["serve", "--addr", ":11435"]
