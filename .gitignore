# Binary build
/bin/
/visionserve

# ONNX weights — NOT committed (large). Download per each model directory's README.
*.onnx
# ...except tiny test fixtures (a few KB), which tests need on a clean clone.
!**/testdata/*.onnx
# ONNX external-data sidecars. torch's exporter externalises the weights of a large model, so
# model.onnx is ~100 KB of graph and model.onnx.data is the other 370-440 MB. Without this line
# `*.onnx` catches only the small half and a plain `git add -A` stages the weights.
*.onnx.data
*.onnx_data
# Sidecars named after the model rather than the .onnx (siglip-text-fp16.data, 220 MB) slipped
# past the two lines above into a commit and blocked the push (GitHub refuses files > 100 MB).
models/**/*.data
*.pt
*.pth
*.engine
*.trt

# Go
*.test
*.out
coverage.*

# Demo artifacts (ảnh COCO tải về + ảnh kết quả có bbox)
/demo/

# Python client build artifacts
clients/python/dist/
clients/python/build/
*.egg-info/
__pycache__/
*.pyc

# Docker (.dockerignore copied to repo root by `make docker`)
/.dockerignore

# OS / editor
.DS_Store
*.swp

# paper
paper/*
blog/*


# Agent git worktrees (Claude Code)
.claude/worktrees/
