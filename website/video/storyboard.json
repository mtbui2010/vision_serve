   "commands": [
    {
     "cmd": "docker run -d -p 11436:11435 -v ~/.visionserve_models:/root/.models --name visionserve mtbui2010/visionserve:latest-cpu",
     "output_file": "out/docker_run.txt"
    },
    {
     "cmd": "docker exec visionserve visionserve pull rf-detr-nano",
     "output_file": "out/pull.txt"
    }
   ]
  },
  {
   "id": "s03_code",
   "type": "code_terminal",
   "step": "Step 2",
   "heading": "Call the model from your code",
   "code": [
    "from visionserve import Client",
    "",
    "c = Client(\"http://localhost:11436\")",
    "res = c.predict(\"rf-detr-nano\", \"cats.jpg\")",
    "print(res.task, f\"{res.duration_ms:.0f} ms\")",
    "for d in res.detections:",
    "    print(d.cls, round(d.conf, 2), [round(v) for v in d.bbox])"
   ],
   "code_size": 20,
   "split_y": 330,
   "terminal_delay": 2.5,
   "pace": 1.6,
